{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "after 17:00 on friday"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "org.openjfx:javafx-controls",
        "org.openjfx:javafx-fxml"
      ],
      "allowedVersions": "/^(?!.*-ea).*/"
    }
  ],
  "rebaseWhen": "behind-base-branch"
}